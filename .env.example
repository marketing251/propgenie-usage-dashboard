# Copy to .env.local for local runs; set the same names in Vercel → Settings → Environment Variables.

# FPFX Wallet API (read-only use). Without a token the dashboard shows seeded demo data.
WALLET_API_URL=https://wallet.fpfxtech.io
WALLET_API_TOKEN=

# Minutes to cache Wallet API responses (default 15).
CACHE_MINUTES=15

# Optional overrides for the Wallet tenantName: {"<tenantUuid>": "Display name", ...}
TENANT_NAMES={}

# ConsumptionInterval for daily buckets (0 = day, 1 = week, 2 = month, 3 = year).
WALLET_DAY_INTERVAL=

# Cloudflare Access (required on Vercel before live data is served).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# Interim: set to vercel-auth when Vercel Deployment Protection covers All Deployments (instead of Cloudflare Access).
PROTECTED_BY=
