# Copy to .env.local for local runs; set the same names in Vercel → Settings → Environment Variables.

# FPFX Wallet API (read-only use). Without a token the dashboard shows seeded demo data.
WALLET_API_URL=https://walletapi.propaccount.com
WALLET_API_TOKEN=

# Minutes to cache Wallet API responses (default 15).
CACHE_MINUTES=15

# Customer names, until the Wallet API exposes them: {"<tenantUuid>": "Customer name", ...}
TENANT_NAMES={}

# Optional: force the ConsumptionInterval value that returns daily buckets (auto-detected otherwise).
WALLET_DAY_INTERVAL=

# Cloudflare Access (required on Vercel before live data is served).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
